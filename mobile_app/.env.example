# Copy to .env. Values from Supabase -> Project Settings -> API (anon/public key only).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: public address of the web app (e.g. https://app.example.co.za), used in confirmation and
# password-reset emails sent from the phone app. In a browser the current address is used automatically.
# <address>/auth/* must be listed under Supabase -> Authentication -> URL Configuration -> Redirect URLs.
EXPO_PUBLIC_WEB_URL=
