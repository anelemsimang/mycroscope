# Copy to .env (development) or %LOCALAPPDATA%\Mycroscope\agent.env (installed agent).
# Values from Supabase -> Project Settings -> API. Use the anon/public key only, never the service_role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_anon_public_key_here

# Optional: public address of the Mycroscope web app. Password-reset emails link to <address>/auth/reset-password.
# Leave empty to use the Site URL set in Supabase -> Authentication -> URL Configuration.
WEB_APP_URL=

# Company install key (manager app -> Settings -> Organisation). Required to install the agent; the installer
# checks it. Keep it with management so an employee cannot reinstall the agent on their own.
INSTALL_KEY=
