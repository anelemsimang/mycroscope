# Copy this file to .env. Values from Supabase → Project Settings → API.
#
# SUPABASE_URL  = "Project URL" (https://xxxxx.supabase.co)
# SUPABASE_KEY  = "anon" "public" key — used by the desktop app. NOT the service_role key.
#
# Keep the service_role secret out of this file for client builds; use it only on a trusted server.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your_anon_public_key_here
