# Copy to .env in this folder, then: docker compose up -d --build
# These three values are compiled into the web app image. Changing them needs a rebuild.
# Use the anon/public key from Supabase -> Project Settings -> API. Never the service_role key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
EXPO_PUBLIC_WEB_URL=https://app.example.co.za

# Host ports. Put TLS in front of these (the platform's proxy, or Caddy).
APP_PORT=8080
SITE_PORT=8081
